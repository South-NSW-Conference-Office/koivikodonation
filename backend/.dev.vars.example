# Copy to .dev.vars for local development. Never commit .dev.vars.
# Use SANDBOX (test mode) values only.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional until the enquiry form is wired up (Resend API key + recipient).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Cloudflare Turnstile secret key (spam check). Leave empty locally to skip the check.
# Cloudflare test keys: 1x0000000000000000000000000000000AA always passes, 2x0000000000000000000000000000000AA always fails.
TURNSTILE_SECRET_KEY=
# Local run only: send the donor back to the page served on this computer
# (python3 -m http.server 3000 --directory ../site). Delete both lines to use the wrangler.toml values.
SUCCESS_URL=http://localhost:3000/thank-you.html
CANCEL_URL=http://localhost:3000/donate-cancelled.html
